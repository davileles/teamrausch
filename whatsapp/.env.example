# Token que o app de agendamento usa para pedir envios.
# Gere um valor longo e aleatorio e repita no servico do app.
WHATSAPP_TOKEN=

# Volume do Railway. A sessao do WhatsApp vive aqui: sem volume,
# voce vai reler o QR a cada deploy.
DATA_DIR=/data

# Pausa entre mensagens. Nao baixe muito: rajada derruba numero.
PAUSA_ENTRE_ENVIOS_MS=1200

# silent | info | debug
LOG_LEVEL=silent

# Quanto o /enviar espera o WhatsApp reconectar antes de responder 503.
ESPERA_CONEXAO_MS=5000

# Prazo para o WhatsApp confirmar um envio (texto / com anexo).
ENVIO_TIMEOUT_MS=25000
ENVIO_TIMEOUT_ANEXO_MS=85000

# Configure TAMBEM no servico do Railway (nao e lido pelo codigo):
# RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0   -> duas instancias na mesma sessao derrubam uma a outra
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS=15 -> tempo para fechar a conexao sem deslogar
