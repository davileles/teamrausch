# =====================================================================
#  App do estudio: check-in Wellhub + agendamento de horarios
# =====================================================================

# --- Wellhub (pedir a Techsales: integrations@gympass.com) ---
WELLHUB_API_KEY=
WELLHUB_WEBHOOK_SECRET=
WELLHUB_GYM_ID=

# bearer (padrao, recomendado) ou apikey (integracoes legadas com X-Api-key)
WELLHUB_AUTH_MODE=bearer

# Producao: https://api.partners.gympass.com/access/v1
# Sandbox:  https://apitesting.partners.gympass.com/access/v1
WELLHUB_API_BASE=https://apitesting.partners.gympass.com/access/v1

# --- Comportamento do check-in ---
# true = nao chama o Wellhub, responde como se tivesse validado.
SIMULAR=true
# true = libera sozinho ao receber o webhook, sem passar pela recepcao
VALIDAR_AUTOMATICO=false
# So ligue para depurar. Nunca em producao.
ACEITAR_SEM_ASSINATURA=false
# Janela de validade quando o payload nao trouxer expiracao
CHECKIN_TTL_MINUTES=60

# --- Acesso as telas de operacao ---
PANEL_TOKEN=troque-por-uma-senha-forte
DEVICE_TOKEN=

# --- Agendamento ---
# Primeiro administrador. So vale enquanto a lista de admins estiver vazia;
# depois disso, gerencie pela aba Configuracoes.
ADMIN_INICIAL=31991444886

# --- WhatsApp (servico irmao neste mesmo repositorio) ---
# Rede privada do Railway: nao exponha o servico de WhatsApp na internet.
# O host e o NOME DO SERVICO no Railway, nao a pasta do repositorio: nesta
# instalacao o servico de WhatsApp chama-se "teamrausch". A porta e a que o
# Railway injeta em PORT (8080) - apontar para :3000 da ECONNREFUSED, e nome
# errado da ENOTFOUND, os dois aparecendo como "fetch failed" no envio.
# Confira com: /wellhub/whatsapp/sondar?token=PANEL_TOKEN&host=teamrausch&porta=8080
WHATSAPP_URL=http://teamrausch.railway.internal:8080/enviar
# Precisa ser o MESMO valor configurado no servico whatsapp.
WHATSAPP_TOKEN=

# --- Dados ---
DATA_DIR=/data
RETER_DIAS=90

# --- Backup da ficha dos alunos no GitHub (opcional) ---
# Guarda telefone, nome e aniversario num repositorio seu, como copia de
# seguranca do volume. SAO DADOS PESSOAIS: use um repositorio PRIVADO.
# Sem GITHUB_TOKEN e GITHUB_REPO o backup fica desligado e o app funciona
# normalmente so com o volume.
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_PATH=teamrausch/alunos.json
GITHUB_PATH_MATRICULAS=teamrausch/matriculas.json
# Lista `id -> telefone` que o app LE no boot para preencher matriculas sem
# telefone (nunca sobrescreve). Reaplique com: /matriculas/telefones/aplicar?token=PANEL_TOKEN
GITHUB_PATH_TELEFONES=teamrausch/telefones.json
GITHUB_BRANCH=main
# Varias alteracoes seguidas viram um commit so. Espera em milissegundos.
GITHUB_DEBOUNCE_MS=8000
